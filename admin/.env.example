NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sua-chave-anon
# Somente no servidor — nunca exponha ao navegador
SUPABASE_SERVICE_ROLE_KEY=sua-chave-service-role
# Opcional: token de acesso do Expo (Enhanced Security for Push)
EXPO_ACCESS_TOKEN=
# Protege a rota de verificação de recibos de push
CRON_SECRET=gere-um-segredo-aleatorio
# Login dos responsáveis (Send SMS Hook do Supabase → WhatsApp)
SUPABASE_AUTH_HOOK_SEND_SMS_SECRET=v1,whsec_gerado-no-painel-do-supabase
# meta | webhook | log (log só em desenvolvimento)
WHATSAPP_PROVEDOR=webhook
# Enviado como "Authorization: Bearer <token>". Configure o mesmo valor no nó Webhook do n8n (Header Auth).
WHATSAPP_TOKEN=gere-um-segredo-aleatorio
# WhatsApp Cloud API (provedor "meta")
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_TEMPLATE=codigo_acesso
WHATSAPP_GRAPH_VERSAO=v21.0
# Provedor "webhook": recebe POST { telefone, codigo, mensagem } e dispara o template aprovado
WHATSAPP_WEBHOOK_URL=https://n8ncz.colegiozampieri.com/webhook/template_app_mural
